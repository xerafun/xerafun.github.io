# ====================================
# GitHub API 配置（可选）
# ====================================

# GitHub Personal Access Token - 用于提高 GitHub API 访问速率
# 未认证：60 次/小时，认证：5000 次/小时
# 创建方式：https://github.com/settings/tokens
# 权限：不需要勾选任何权限（只读公开数据）
# GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ====================================
# 代理配置（可选）
# ====================================

# 如果需要通过代理访问外部服务，请配置以下变量
# 注意：需要在启动时设置 ENABLE_PROXY=true 或使用 npm run dev:proxy
# HTTPS_PROXY="http://127.0.0.1:7890"
# HTTP_PROXY="http://127.0.0.1:7890"
